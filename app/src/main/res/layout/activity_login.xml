<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.LoginActivity">


    <ImageView
        android:id="@+id/imageView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/top_background"
        tools:layout_editor_absoluteY="-79dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kosh keldiniz"
                android:textColor="#603a91"
                android:textSize="40sp"
                android:textStyle="bold"
                android:layout_marginBottom="100dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="100dp"/>

            <EditText
                android:id="@+id/editTextTextPersonName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:ems="10"
                android:inputType="textPersonName"
                android:background="@drawable/edittext_bg"
                android:drawableStart="@drawable/name"
                android:textColorHint="#603a91"
                android:hint="Login"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:padding="8dp"
                android:drawablePadding="16dp"
                />
            <EditText
                android:id="@+id/editTextTextPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:ems="10"
                android:inputType="textPassword"
                android:background="@drawable/edittext_bg"
                android:drawableStart="@drawable/password"
                android:textColorHint="#603a91"
                android:hint="Qūpia söz "
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:padding="8dp"
                android:drawablePadding="16dp"
                />

            <ImageView
                android:id="@+id/imgHome"
                android:layout_gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:srcCompat="@drawable/btn_login" />

            <Button
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                style="@android:style/Widget.Button"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/edittext_bg"
                android:drawableStart="@drawable/google"
                android:text="Google arqyly tırkelu "
                android:padding="16dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#603a91"
                android:layout_marginTop="16dp"
                android:drawablePadding="16dp"/>
            <Button
                android:id="@+id/button1"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                style="@android:style/Widget.Button"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/edittext_bg"
                android:drawableStart="@drawable/facebook"
                android:text="Facebook arqyly tırkelu"
                android:padding="16dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#603a91"
                android:layout_marginTop="16dp"
                android:drawablePadding="16dp"/>

            <TextView
                android:id="@+id/logTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sız jaña paidalanuşysyz ba? Tırkelu"
                android:textColor="#603a91"
                android:textAlignment="center"
                android:layout_marginTop="32dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>